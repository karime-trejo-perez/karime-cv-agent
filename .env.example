# Copia este archivo a .env y completa tu API key real. NUNCA subas .env al repo.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo de Anthropic a usar. claude-haiku-4-5 recomendado por costo/latencia
# para un agente de dominio acotado como este.
ANTHROPIC_MODEL=claude-haiku-4-5

# Opcional: llave para proteger el endpoint (ver app/main.py si decides
# agregar autenticación). No usada por defecto en este alcance.
# AGENT_API_KEY=
